<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contract models generated from schemas/**/*.schema.json (ADR-0024).

  Deliberately dependency-free in compile scope: generated records convert to and
  from java.util.Map rather than depending on a JSON binding library, so that
  consuming the contracts never forces a serialisation choice on the consumer.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.aiplatform</groupId>
  <artifactId>contracts</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>AI Engineering Platform contracts</name>
  <description>Generated Java models for the V1 domain contracts.</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
