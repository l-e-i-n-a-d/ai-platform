{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.internal/schemas/v1/model/model-request.schema.json",
  "title": "ModelRequest",
  "description": "The provider-neutral request accepted by the model gateway (ADR-0010 §1). Provider-specific SDK calls live behind the gateway and nowhere else. ADR-0010 §2: the gateway does not run the tool-calling loop — it normalises tool calls into requests, and the tool layer decides and executes. Most agent frameworks do run the loop in this position, so this is the default to resist.",
  "type": "object",
  "properties": {
    "modelRef": {
      "type": "string",
      "description": "A logical name resolved by the gateway, not a provider model id. Callers never name a provider model directly.",
      "minLength": 1
    },
    "system": {
      "type": "array",
      "description": "Platform-authored instruction blocks. Never assembled from retrieved content.",
      "items": { "type": "string" }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "enum": ["USER", "ASSISTANT", "TOOL_RESULT"] },
          "content": {
            "type": "array",
            "items": { "$ref": "#/$defs/contentBlock" },
            "minItems": 1
          },
          "toolCallId": {
            "type": "string",
            "description": "Present on TOOL_RESULT messages, correlating to the originating tool call.",
            "minLength": 1
          }
        },
        "required": ["role", "content"],
        "additionalProperties": false,
        "allOf": [
          {
            "$comment": "A tool call is something only the assistant can have made. Permitting a TOOL_CALL block on a USER or TOOL_RESULT message would let retrieved or tool-returned content masquerade as a model decision.",
            "if": {
              "properties": { "role": { "enum": ["USER", "TOOL_RESULT"] } },
              "required": ["role"]
            },
            "then": {
              "properties": {
                "content": {
                  "items": {
                    "not": {
                      "properties": { "type": { "const": "TOOL_CALL" } },
                      "required": ["type"]
                    }
                  }
                }
              }
            }
          },
          {
            "$comment": "Without this correlation the result cannot be matched to the call that produced it, which is the mirror half of representing the assistant's tool-call turn.",
            "if": {
              "properties": { "role": { "const": "TOOL_RESULT" } },
              "required": ["role"]
            },
            "then": { "required": ["toolCallId"] }
          }
        ]
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "description": "Derived from tool descriptors the grant permits. The gateway advertises tools; it does not hold or invoke them.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "inputSchema": { "$ref": "../common/common.schema.json#/$defs/jsonSchema" }
        },
        "required": ["name", "description", "inputSchema"],
        "additionalProperties": false
      }
    },
    "toolChoice": {
      "oneOf": [
        { "type": "string", "enum": ["AUTO", "REQUIRED", "NONE"] },
        {
          "type": "object",
          "properties": { "name": { "type": "string" } },
          "required": ["name"],
          "additionalProperties": false
        }
      ]
    },
    "outputContract": {
      "$ref": "../common/common.schema.json#/$defs/jsonSchema",
      "description": "Required when the caller needs a structured result."
    },
    "params": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "topP": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "stopSequences": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxInputTokens": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      },
      "required": ["maxInputTokens", "maxOutputTokens", "timeoutMs"],
      "additionalProperties": false
    },
    "providerOptions": {
      "type": "object",
      "description": "A narrow, explicitly-labelled escape hatch (ADR-0010 §4). Anything placed here is by definition not portable across providers, and the name says so.",
      "properties": {
        "provider": { "type": "string" },
        "options": { "type": "object" }
      },
      "required": ["provider", "options"],
      "additionalProperties": false
    },
    "correlation": { "$ref": "../common/common.schema.json#/$defs/correlation" }
  },
  "required": ["modelRef", "system", "messages", "budgets", "correlation"],
  "additionalProperties": false,
  "$defs": {
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "TEXT" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "ARTIFACT" },
            "ref": { "$ref": "../artifacts/artifact-ref.schema.json" }
          },
          "required": ["type", "ref"],
          "additionalProperties": false
        },
        {
          "$comment": "Carries the assistant's own tool-call turn back into history. Both major providers require that turn to precede the corresponding tool result, so without it an agent loop of more than one iteration cannot be expressed and the gateway would have to reconstruct or drop it. Self-contained rather than referencing ModelResponse.toolCalls[], because a request carries no such array.",
          "type": "object",
          "properties": {
            "type": { "const": "TOOL_CALL" },
            "toolCallId": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "arguments": { "type": "object" }
          },
          "required": ["type", "toolCallId", "name", "arguments"],
          "additionalProperties": false
        }
      ]
    }
  }
}
